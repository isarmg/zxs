+	    lp_usershare_max_shares() != 0 ||
+	    !zxs_empty(lp_defaultservice(mem_ctx, sub)) ||
+	    !zxs_empty(lp_auto_services(mem_ctx, sub)) ||
+	    !zxs_empty(lp_username_map(mem_ctx, sub)) ||
+	    !zxs_empty(lp_username_map_script(mem_ctx, sub)) ||
+	    lp_servicenumber(HOMES_NAME) >= 0 ||
+	    lp_servicenumber(PRINTERS_NAME) >= 0) {
+		return false;
+	}
+	ipc = lp_servicenumber("IPC$");
