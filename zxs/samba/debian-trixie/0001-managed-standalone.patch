+/* The caller has a real FSP and a fresh zero-row or zero-byte reply
+ * on its original TCON. No host inode, stat, EA or filesystem fallback. */
+_PUBLIC_
+bool zxs_root_info_class(uint8_t info)
+{
+	return info==FSCC_FILE_BASIC_INFORMATION || info==FSCC_FILE_STANDARD_INFORMATION ||
+	       info==FSCC_FILE_INTERNAL_INFORMATION || info==FSCC_FILE_ALL_INFORMATION ||
+	       info==FSCC_FILE_NETWORK_OPEN_INFORMATION;
+}
+bool zxs_root_info_needs_attributes(uint8_t info)
+{
+	return info==FSCC_FILE_BASIC_INFORMATION || info==FSCC_FILE_ALL_INFORMATION ||
+	       info==FSCC_FILE_NETWORK_OPEN_INFORMATION;
+}
+bool zxs_member_info_class(uint8_t info)
+{
+	return zxs_root_info_class(info) || info==FSCC_FILE_ACCESS_INFORMATION ||
+	       info==FSCC_FILE_ATTRIBUTE_TAG_INFORMATION;
+}
+bool zxs_member_info_needs_attributes(uint8_t info)
+{
+	return zxs_root_info_needs_attributes(info) || info==FSCC_FILE_ATTRIBUTE_TAG_INFORMATION;
+}
+static NTSTATUS zxs_format_logical_info(TALLOC_CTX *ctx,files_struct *fsp,uint8_t cls,uint32_t limit,
+				       bool member,bool delete_pending,DATA_BLOB *out,NTSTATUS *call_status)
+{
+	size_t fixed=0;unsigned int n=0;char *b=NULL;
+	NTSTATUS status;
+	if(!(member?zxs_member_info_class(cls):zxs_root_info_class(cls)))return NT_STATUS_NOT_SUPPORTED;
+	if(fsp==NULL || fsp->fsp_flags.is_directory==member || fsp->fsp_name==NULL ||
+	   fsp->fsp_name->base_name==NULL || fsp->fsp_name->base_name[0]==0 ||
+	   strlen(fsp->fsp_name->base_name)>ZXS_OD_PATH_MAX+ZXS_DIR_NAME+1 ||
+	   fsp->fsp_name->base_name[0]=='\\' || strchr(fsp->fsp_name->base_name,'/')!=NULL ||
+	   fsp->fsp_name->stream_name!=NULL ||
+	   !zxs_file_vfs_active(fsp->conn))return NT_STATUS_ACCESS_DENIED;
+	uint16_t level=cls==FSCC_FILE_ALL_INFORMATION?SMB2_FILE_ALL_INFORMATION:cls+NT_PASSTHROUGH_OFFSET;
+	/* The selected logical path is bounded independently of the caller's credits. */
+	status=qfilepathinfo_with_logical(fsp->conn,ctx,NULL,level,fsp,fsp->fsp_name,delete_pending,
+					  make_omit_timespec(),NULL,STR_UNICODE,MIN(limit,2*(ZXS_OD_PATH_MAX+ZXS_DIR_NAME+1)+256),
+					  &fixed,&b,&n,true);
+	if(NT_STATUS_IS_OK(status)){
+		if(limit<fixed)status=NT_STATUS_INFO_LENGTH_MISMATCH;
+		else{
+			*out=data_blob_talloc(ctx,b,MIN(n,limit));
+			*call_status=n>limit?STATUS_BUFFER_OVERFLOW:NT_STATUS_OK;
+			if(out->data==NULL)status=NT_STATUS_NO_MEMORY;
+		}
+	}
+	SAFE_FREE(b);
+	return status;
+}
+_PUBLIC_
+NTSTATUS zxs_format_root_info(TALLOC_CTX *ctx,files_struct *fsp,uint8_t cls,uint32_t limit,
+			      DATA_BLOB *out,NTSTATUS *call_status)
+{
+	return zxs_format_logical_info(ctx,fsp,cls,limit,false,false,out,call_status);
+}
+_PUBLIC_
+NTSTATUS zxs_format_member_info(TALLOC_CTX *ctx,files_struct *fsp,uint8_t cls,uint32_t limit,
+				bool delete_pending,DATA_BLOB *out,NTSTATUS *call_status)
+{
+	return zxs_format_logical_info(ctx,fsp,cls,limit,true,delete_pending,out,call_status);
 }
 
