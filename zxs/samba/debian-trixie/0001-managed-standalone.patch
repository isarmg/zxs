+static bool zxs_getinfo_current(const struct smbd_smb2_getinfo_state *state)
+{
+	struct smbd_smb2_request *n=state->smb2req;
+	struct files_struct *f=state->zxs_fsp;
+	if(f==NULL || !zxs_request_root_current(n) || f->conn!=n->tcon->compat ||
+	   f->vuid!=n->session->global->session_wire_id || !f->fsp_flags.is_fsa ||
+	   f->fsp_flags.closing || f->op==NULL || f->op->global==NULL)return false;
+	if(state->zxs_member){
+		const struct zxs_read_fsp *m=zxs_find_read(f);
+		uint64_t dev=0,ext=0;
+		if(m==NULL || m->fd<0 || zxs_member_held(m->fd)!=0 || f->fsp_flags.is_pathref ||
+		   m->session!=n->session || m->tcon!=n->tcon ||
+		   m->seq!=n->session->global->auth_session_info_seqnum ||
+		   !zxs_request_folder_current(n,&m->folder) ||
+		   memcmp(m->member.pool,n->tcon->zxs_tree_choice->pool,16)!=0 ||
+		   memcmp(m->member.volume,m->folder.volume,16)!=0)return false;
+		for(size_t i=0;i<8;i++){dev=(dev<<8)|m->member.pool[i];ext=(ext<<8)|m->member.pool[8+i];}
+		if(f->file_id.devid!=dev || f->file_id.extid!=ext || f->file_id.inode!=m->member.number ||
+		   f->fsp_name==NULL || f->fsp_name->st.st_ex_size<0 ||
+		   (uint64_t)f->fsp_name->st.st_ex_size!=m->member.size ||
+		   f->fsp_name->st.st_ex_ino!=m->member.number)return false;
+	}else{
+		const struct zxs_dir_search *d=zxs_find_dir(f);
+		if(d==NULL || d->session!=n->session || d->tcon!=n->tcon ||
+		   d->seq!=n->session->global->auth_session_info_seqnum ||
+		   (d->folder.mode!=0 && !zxs_request_folder_current(n,&d->folder)) ||
+		   !zxs_directory_same_id(f,d->folder.mode==0?n->tcon->zxs_tree_choice:&d->folder))return false;
+	}
+	return change_to_user_and_service(f->conn,f->vuid);
+}
+static NTSTATUS zxs_getinfo_format_member(struct smbd_smb2_getinfo_state *s)
+{
+	struct files_struct *fsp=s->zxs_fsp;
+	const struct zxs_read_fsp *m=zxs_find_read(fsp);
+	bool pending=false;
+	if(m==NULL)return NT_STATUS_ACCESS_DENIED;
+	if(m->busy || m->member.size!=s->zxs_size)return NT_STATUS_SHARING_VIOLATION;
+	if(s->zxs_class==FSCC_FILE_STANDARD_INFORMATION || s->zxs_class==FSCC_FILE_ALL_INFORMATION){
+		/* A different real open may have set or cleared this logical link.
+		 * Failure to read the native record isn't evidence for false. */
+		struct share_mode_lock *lock=fetch_share_mode_unlocked(s,fsp->file_id);
+		if(lock==NULL)return NT_STATUS_ACCESS_DENIED;
+		pending=is_delete_on_close_set(lock,fsp->name_hash);
+		TALLOC_FREE(lock);
+	}
+	return zxs_format_member_info(s,fsp,s->zxs_class,s->zxs_max,pending,
+				      &s->out_output_buffer,&s->status);
+}
+static bool zxs_getinfo_cancel(struct tevent_req *req)
+{
+	struct smbd_smb2_getinfo_state *s=tevent_req_data(req,struct smbd_smb2_getinfo_state);
+	return zxs_dir_wait_cancel(req,s->smb2req->xconn->client->raw_ev_ctx,
+				   &s->zxs_wait,&s->zxs_link);
+}
+static void zxs_getinfo_done(struct tevent_req *sub)
+{
+	struct tevent_req *req=tevent_req_callback_data(sub,struct tevent_req);
+	struct smbd_smb2_getinfo_state *s=tevent_req_data(req,struct smbd_smb2_getinfo_state);
+	NTSTATUS status;
+	struct zxs_ns_space capacity={0};
+	if(s->zxs_filesystem){status=zxs_capacity_recv(sub,&capacity);}
+	else if(s->zxs_member){
+		uint8_t *private=NULL;size_t n=0;
+		status=zxs_delivery_recv(sub,s,&private,&n);
+		TALLOC_FREE(private);
+		if(NT_STATUS_IS_OK(status) && n!=0)status=NT_STATUS_ACCESS_DENIED;
+	}else{status=zxs_dir_cut_recv(sub,NULL);}
+	s->zxs_wait=NULL;TALLOC_FREE(sub);
+	if(NT_STATUS_IS_OK(status)){
+		if(!zxs_getinfo_current(s)){status=NT_STATUS_ACCESS_DENIED;}
+		else if(s->zxs_filesystem){status=zxs_format_capacity(s,&capacity,s->zxs_class,s->zxs_max,
+			zxs_capacity_may_write(s->zxs_fsp->conn),&s->out_output_buffer);}
+		else if(s->zxs_fs_attributes){status=zxs_format_fs_attributes(s,s->zxs_max,
+			&s->out_output_buffer,&s->status);}
+		else if(s->zxs_member){status=zxs_getinfo_format_member(s);}
+		else{status=zxs_format_root_info(s,s->zxs_fsp,s->zxs_class,s->zxs_max,
+						&s->out_output_buffer,&s->status);}
+	}
+	TALLOC_FREE(s->zxs_link);
+	if(tevent_req_nterror(req,status))return;
+	tevent_req_done(req); /* terminal: native recv can release state now */
+}
+static bool zxs_getinfo_volume_scope(const struct files_struct *fsp,const struct zxs_smb_tree_cut **scope)
+{
+	if(fsp->fsp_flags.is_directory){
+		const struct zxs_dir_search *dir=zxs_find_dir(fsp);
+		if(dir==NULL)return false;
+		*scope=dir->folder.mode==0?NULL:&dir->folder;
+	}else{
+		const struct zxs_read_fsp *member=zxs_find_read(fsp);
+		if(member==NULL)return false;
+		*scope=&member->folder;
+	}
+	return *scope==NULL || !zxs_folder_retained(*scope);
+}
+static NTSTATUS zxs_getinfo_logical(struct tevent_req *req,struct tevent_context *ev,
+				  struct files_struct *fsp,uint8_t type,uint8_t cls,
+				  uint32_t max,DATA_BLOB input,uint32_t additional,uint32_t flags)
+{
+	struct smbd_smb2_getinfo_state *s=tevent_req_data(req,struct smbd_smb2_getinfo_state);
+	s->zxs_member=!fsp->fsp_flags.is_directory;
+	s->zxs_filesystem=type==SMB2_0_INFO_FILESYSTEM && zxs_capacity_info_class(cls);
+	s->zxs_fs_attributes=type==SMB2_0_INFO_FILESYSTEM && cls==ZXS_INFO_FS_ATTRIBUTE;
+	const struct zxs_smb_tree_cut *scope=NULL;
+	if(s->zxs_filesystem || s->zxs_fs_attributes){
+		/* A true ordinary selection pins its own F. No S/R, cwd or
+		 * reference fallback is allowed when a body scope is known. */
+		if(!zxs_getinfo_volume_scope(fsp,&scope) ||
+		   (s->zxs_fs_attributes && scope!=NULL))return NT_STATUS_NOT_SUPPORTED;
+		const uint32_t minimum=s->zxs_fs_attributes?12u:(cls==ZXS_INFO_FS_FULL_SIZE?32u:24u);
+		if(max<minimum)return NT_STATUS_INFO_LENGTH_MISMATCH;
+	}else if(type!=SMB2_0_INFO_FILE || !(s->zxs_member?zxs_member_info_class(cls):zxs_root_info_class(cls))){
+		return NT_STATUS_NOT_SUPPORTED;
+	}
+	if(input.length!=0 || additional!=0 || flags!=0)return NT_STATUS_INVALID_PARAMETER;
+	s->zxs_fsp=fsp;s->zxs_class=cls;s->zxs_max=max;
+	if(!zxs_getinfo_current(s))return NT_STATUS_ACCESS_DENIED;
+	const bool attributes=!s->zxs_filesystem && !s->zxs_fs_attributes &&
+		(s->zxs_member?zxs_member_info_needs_attributes(cls):zxs_root_info_needs_attributes(cls));
+	if(attributes && (fsp->access_mask&SEC_FILE_READ_ATTRIBUTE)==0)return NT_STATUS_ACCESS_DENIED;
+	const struct zxs_read_fsp *m=s->zxs_member?zxs_find_read(fsp):NULL;
+	if(m!=NULL && !s->zxs_filesystem){
+		if(m->busy)return NT_STATUS_SHARING_VIOLATION;
+		s->zxs_size=m->member.size;
+	}
+	s->zxs_link=aio_add_req_to_fsp(fsp,req);
+	if(s->zxs_link==NULL)return NT_STATUS_NO_MEMORY;
+	talloc_steal(s,s->zxs_link);
+	if(s->zxs_filesystem){
+		s->zxs_wait=zxs_capacity_send(s,ev,s->smb2req,scope,zxs_capacity_may_write(fsp->conn));
+	}else if(m!=NULL){
+		/* The storage worker proves this exact member's held view and
+		 * current authority, but no FILE_READ_DATA or data I/O is needed. */
+		s->zxs_wait=zxs_delivery_send(s,ev,m->fd,0,0,0);
+	}else{
+		const struct zxs_dir_search *d=zxs_find_dir(fsp);
+		const struct zxs_smb_tree_cut *folder=d->folder.mode==0?NULL:&d->folder;
+		s->zxs_wait=zxs_dir_cut_send(s,ev,s->smb2req,folder,0,NULL,0);
+	}
+	if(s->zxs_wait==NULL){TALLOC_FREE(s->zxs_link);return NT_STATUS_NO_MEMORY;}
+	smb2_request_set_async_internal(s->smb2req,true);
+	tevent_req_set_cancel_fn(req,zxs_getinfo_cancel);
+	tevent_req_set_callback(s->zxs_wait,zxs_getinfo_done,req);
+	return NT_STATUS_OK;
+}
 
