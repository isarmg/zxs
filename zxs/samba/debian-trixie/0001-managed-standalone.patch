+/* Resolve only the installation's locked UNIX execution principal. It
+ * neither authenticates a user nor looks up the client's network name. */
+static bool zxs_same_identity(const struct zxs_smb_generation *cut,
+			      const struct auth_session_info *info)
+{
+	const struct dom_sid *s;
+	const struct security_unix_token *u;
+	struct passwd rec, *pw=NULL;
+	char buf[16384];
+	if (info==NULL || info->info==NULL || info->info->domain_name==NULL ||
+	    !strequal(info->info->domain_name,"ZXSLOCAL") ||
+	    info->info->account_name==NULL || strcmp(cut->login,info->info->account_name)!=0 ||
+	    !zxs_normal_token(info)) { return false; }
+	u=info->unix_token;
+	if (u==NULL || getpwnam_r("zxs-smb-client",&rec,buf,sizeof(buf),&pw)!=0 ||
+	    info->unix_info==NULL ||
+	    !zxs_fixed_unix_mapping(pw,info->unix_info->unix_name,u->uid,u->gid) ||
+	    (u->ngroups!=0 && u->groups==NULL)) { return false; }
+	for (uint32_t i=0;i<u->ngroups;i++) {
+		if (u->groups[i]!=pw->pw_gid) { return false; }
+	}
+	s=&info->security_token->sids[0];
+	if (s->sid_rev_num!=cut->sid[0] || s->num_auths!=5 || cut->sid[1]!=5 ||
+	    memcmp(s->id_auth,cut->sid+2,6)!=0) { return false; }
+	for (size_t i=0;i<5;i++) {
+		if (s->sub_auths[i]!=IVAL(cut->sid,8+4*i)) { return false; }
+	}
+	return true;
+}
