+/* Dedicated virtual FILEs use the original link-level marker and native
+ * share-mode lock, but never the stock unlink. These fields are stored
+ * only in this build's ephemeral native lock DB, not on SMB or S. */
+enum zxs_disposition_phase{ZXS_MARK_OWNER=1,ZXS_MARK_CLOSED=2};
+
+static bool zxs_mark_owner(const struct delete_token *tag,const struct server_id *who,uint64_t id)
+{
+	return tag->zxs_phase==ZXS_MARK_OWNER&&tag->zxs_owner_file_id==id&&server_id_equal(&tag->zxs_owner,who);
+}
+struct zxs_close_entries{
+	struct files_struct *self;
+	struct server_id worker;
+	const struct delete_token *tag;
+	bool found,other,owner;
+};
+static bool zxs_find_close_entry(struct share_mode_entry *e,bool *modified,void *private_data)
+{
+	struct zxs_close_entries *q=private_data;
+	if(e->name_hash!=q->self->name_hash||share_entry_stale_pid(e))return false;
+	if(e->share_file_id==fh_get_gen_id(q->self->fh)&&server_id_equal(&e->pid,&q->worker)){q->found=true;}
+	else{q->other=true;}
+	if(q->tag!=NULL&&zxs_mark_owner(q->tag,&e->pid,e->share_file_id))q->owner=true;
+	return false; /* inspect all entries; do not mistake a scan error for last */
+}
+
+bool zxs_store_disposition(files_struct *fsp,bool enabled,const uint8_t mark[16])
+{
+	struct share_mode_lock *lck;
+	struct share_mode_data *d=NULL;
+	struct delete_token *stamp=NULL;
+	struct zxs_close_entries q={.self=fsp};
+	const uint8_t zero[16]={0};
+	bool ok=false;
+	if(fsp==NULL||fsp->conn==NULL||fsp->conn->session_info==NULL||
+	   (fsp->access_mask&SEC_STD_DELETE)==0||fsp_get_smb2_lease(fsp)!=NULL||
+	   (enabled&&(mark==NULL||memcmp(mark,zero,16)==0)))return false;
+	q.worker=messaging_server_id(fsp->conn->sconn->msg_ctx);
+	lck=get_existing_share_mode_lock(talloc_tos(),fsp->file_id);
+	if(lck==NULL)return false;
+	if(!NT_STATUS_IS_OK(share_mode_lock_access_private_data(lck,&d))||
+	   !share_mode_forall_entries(lck,zxs_find_close_entry,&q)||!q.found)goto done;
+	if(!enabled){
+		reset_delete_on_close_lck(fsp,lck);fsp->fsp_flags.delete_on_close=false;ok=true;goto done;
+	}
+	set_delete_on_close_lck(fsp,lck,fsp->conn->session_info->security_token,fsp->conn->session_info->unix_token);
+	stamp=find_delete_on_close_token(d,fsp->name_hash);
+	if(stamp==NULL){reset_delete_on_close_lck(fsp,lck);goto done;}
+	stamp->zxs_owner=q.worker;stamp->zxs_owner_file_id=fh_get_gen_id(fsp->fh);
+	stamp->zxs_phase=ZXS_MARK_OWNER;memcpy(stamp->zxs_mark,mark,16);d->modified=true;
+	fsp->fsp_flags.delete_on_close=true;ok=true;
+done:
+	TALLOC_FREE(lck);return ok;
+}
+int zxs_claim_explicit_delete(files_struct *fsp,uint8_t mark[16])
+{
+	struct share_mode_lock *lck=NULL;
+	struct share_mode_data *d=NULL;
+	struct delete_token *tag=NULL;
+	struct zxs_close_entries q={.self=fsp};
+	const uint8_t zero[16]={0};
+	int answer=-1;
+	if(fsp==NULL||mark==NULL||fsp_get_smb2_lease(fsp)!=NULL)return -1;
+	q.worker=messaging_server_id(fsp->conn->sconn->msg_ctx);
+	lck=get_existing_share_mode_lock(talloc_tos(),fsp->file_id);
+	if(lck==NULL)return -1;
+	if(!NT_STATUS_IS_OK(share_mode_lock_access_private_data(lck,&d)))goto done;
+	tag=find_delete_on_close_token(d,fsp->name_hash);
+	if(tag==NULL){answer=0;goto done;}
+	q.tag=tag;
+	if((tag->zxs_phase!=ZXS_MARK_OWNER&&tag->zxs_phase!=ZXS_MARK_CLOSED)||
+	   memcmp(tag->zxs_mark,zero,16)==0||
+	   !share_mode_forall_entries(lck,zxs_find_close_entry,&q)||!q.found)goto done;
+	if(tag->zxs_phase==ZXS_MARK_OWNER&&!q.owner){
+		/* The issuing open vanished without passing explicit CLOSE.
+		 * A compatible reader must not inherit an abandoned request. */
+		reset_delete_on_close_lck(fsp,lck);answer=0;goto done;
+	}
+	if(q.other){
+		const bool hand= zxs_mark_owner(tag,&q.worker,fh_get_gen_id(fsp->fh));
+		/* Remove precisely this nonlast original record, and only when
+		 * the issuing native open explicitly closes can surviving opens
+		 * carry its intent to their own last explicit CLOSE. */
+		if(del_share_mode(lck,fsp)){
+			if(hand){tag->zxs_phase=ZXS_MARK_CLOSED;d->modified=true;}
+			answer=2;
+		}
+		goto done;
+	}
+	memcpy(mark,tag->zxs_mark,16);answer=1; /* marker excludes new opens until final close */
+done:
+	TALLOC_FREE(lck);return answer;
+}
+void zxs_forget_virtual_disposition(struct share_mode_lock *lck,files_struct *fsp,bool implicit)
+{
+	struct share_mode_data *d=NULL;
+	struct delete_token *tag=NULL;
+	struct zxs_close_entries q={.self=fsp,.worker=messaging_server_id(fsp->conn->sconn->msg_ctx)};
+	if(!NT_STATUS_IS_OK(share_mode_lock_access_private_data(lck,&d)))return;
+	tag=find_delete_on_close_token(d,fsp->name_hash);
+	if(tag==NULL)return;
+	if((implicit&&zxs_mark_owner(tag,&q.worker,fh_get_gen_id(fsp->fh)))||
+	   (share_mode_forall_entries(lck,zxs_find_close_entry,&q)&&q.found&&!q.other)){
+		reset_delete_on_close_lck(fsp,lck);
+	}
+}
+
+/* While a selected ordinary open renames its logical link, block both
+ * old- and new-name admissions under the actual FILE share-mode lock.
+ * Retained links and delete-on-close keep their independent identity. */
+struct zxs_rename_entries {
+	struct server_id owner;
+	uint64_t open_id;
+	uint32_t old_hash,new_hash;
+	bool check_name,write,seen,found,other;
+};
+static bool zxs_scan_ordinary_rename(struct share_mode_entry *e,bool *modified,void *private_data)
+{
+	struct zxs_rename_entries *q=private_data;
+	const bool owner=server_id_equal(&q->owner,&e->pid)&&q->open_id==e->share_file_id;
+	const bool retained=(e->name_hash&UINT32_C(0x80000000))!=0;
+	if(owner){
+		/* Even a stale or retained duplicate is not a unique owner. */
+		if(q->seen||retained)return true;
+		q->seen=true;
+	}
+	if(retained||share_entry_stale_pid(e))return false;
+	if(!owner||(q->check_name&&e->name_hash!=q->old_hash)){
+		q->other=true;return q->write;
+	}
+	q->found=true;
+	if(q->write){e->name_hash=q->new_hash;*modified=true;}
+	return false;
+}
+static void zxs_clear_rename(struct share_mode_data *d)
+{
+	d->zxs_ordinary_rename=false;ZERO_STRUCT(d->zxs_rename_owner);
+	d->zxs_rename_file_id=0;d->modified=true;
+}
+bool zxs_rename_blocks_ordinary_open(struct share_mode_lock *lck)
+{
+	struct share_mode_data *d=NULL;
+	if(!NT_STATUS_IS_OK(share_mode_lock_access_private_data(lck,&d)))return true;
+	if(!d->zxs_ordinary_rename)return false;
+	struct zxs_rename_entries q={.owner=d->zxs_rename_owner,.open_id=d->zxs_rename_file_id};
+	if(!zxs_share_mode_scan_rename(lck,zxs_scan_ordinary_rename,&q)||q.found)return true;
+	/* The original open died. Never recover a ZXS operation using this
+	 * lock record; the independent storage receipt decides that. */
+	zxs_clear_rename(d);return false;
+}
+NTSTATUS zxs_claim_ordinary_rename(files_struct *fsp)
+{
+	if(fsp==NULL||fsp->conn==NULL||fsp->fsp_flags.is_directory||fsp->fsp_flags.closing||
+	   (fsp->access_mask&SEC_STD_DELETE)==0||
+	   (fsp->name_hash&UINT32_C(0x80000000))!=0||fsp_get_smb2_lease(fsp)!=NULL){
+		return NT_STATUS_ACCESS_DENIED;
+	}
+	struct zxs_rename_entries q={
+		.owner=messaging_server_id(fsp->conn->sconn->msg_ctx),
+		.open_id=fh_get_gen_id(fsp->fh),.old_hash=fsp->name_hash,.check_name=true,
+	};
+	struct share_mode_lock *lck=get_existing_share_mode_lock(talloc_tos(),fsp->file_id);
+	if(lck==NULL)return NT_STATUS_ACCESS_DENIED;
+	struct share_mode_data *d=NULL;
+	NTSTATUS answer=NT_STATUS_ACCESS_DENIED;
+	if(!NT_STATUS_IS_OK(share_mode_lock_access_private_data(lck,&d))||
+	   !zxs_share_mode_scan_rename(lck,zxs_scan_ordinary_rename,&q)||!q.found)goto done;
+	if(q.other||d->zxs_ordinary_rename||find_delete_on_close_token(d,fsp->name_hash)!=NULL){
+		answer=NT_STATUS_SHARING_VIOLATION;goto done;
+	}
+	d->zxs_ordinary_rename=true;d->zxs_rename_owner=q.owner;d->zxs_rename_file_id=q.open_id;d->modified=true;
+	answer=NT_STATUS_OK;
+done:
+	TALLOC_FREE(lck);return answer;
+}
+/* The authenticated storage result is already settled. Update only the
+ * one native owner's pathname and admission record, never the host VFS. */
+bool zxs_release_ordinary_rename(files_struct *fsp,const struct smb_filename *target)
+{
+	struct zxs_rename_entries q={
+		.owner=messaging_server_id(fsp->conn->sconn->msg_ctx),
+		.open_id=fh_get_gen_id(fsp->fh),.old_hash=fsp->name_hash,.check_name=target!=NULL,
+	};
+	struct share_mode_lock *lck=get_existing_share_mode_lock(talloc_tos(),fsp->file_id);
+	if(lck==NULL)return false;
+	struct share_mode_data *d=NULL;bool ok=false;
+	if(!NT_STATUS_IS_OK(share_mode_lock_access_private_data(lck,&d))||!d->zxs_ordinary_rename||
+	   !server_id_equal(&d->zxs_rename_owner,&q.owner)||d->zxs_rename_file_id!=q.open_id)goto done;
+	if(!zxs_share_mode_scan_rename(lck,zxs_scan_ordinary_rename,&q))goto done;
+	if(target!=NULL){
+		if(!q.found||q.other||
+		   target->stream_name!=NULL||d->stream_name!=NULL||
+		   find_delete_on_close_token(d,fsp->name_hash)!=NULL)goto done;
+		char *base=talloc_strdup(d,target->base_name);
+		if(base==NULL||!NT_STATUS_IS_OK(fsp_set_smb_fname(fsp,target))){TALLOC_FREE(base);goto done;}
+		fsp->name_hash&=UINT32_C(0x7fffffff);
+		fsp->fsp_name->st.cached_dos_attributes=FILE_ATTRIBUTE_NORMAL;
+		q.seen=false;q.found=false;q.write=true;q.new_hash=fsp->name_hash;
+		if(!zxs_share_mode_scan_rename(lck,zxs_scan_ordinary_rename,&q)||!q.found){
+			TALLOC_FREE(base);goto done;
+		}
+		TALLOC_FREE(d->base_name);d->base_name=base;
+	}
+	zxs_clear_rename(d);ok=true;
+done:
+	TALLOC_FREE(lck);return ok;
 }
 
