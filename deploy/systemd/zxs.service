[Unit]
Description=ZXS Web management and storage daemon
Documentation=file:/opt/zxs/README.md
After=local-fs.target network.target

[Service]
Type=simple
User=zxs
Group=zxs
UMask=0077
StateDirectory=zxs
StateDirectoryMode=0700
# Runtime state contains sockets only. Retained SMB data belongs to
# --management-root/smb-spool under the persistent StateDirectory.
RuntimeDirectory=zxs
RuntimeDirectoryMode=0700
WorkingDirectory=/var/lib/zxs
ExecStart=/opt/zxs/bin/zxs --root /var/lib/zxs/state --management-root /var/lib/zxs/management --listen 0.0.0.0:7400 --external-origin https://zxs.example.com --web-dir /opt/zxs/web --setup-disk P01=/srv/zxs/disks/P01
KillSignal=SIGINT
# Do not kill admitted durability/recovery work during normal shutdown.
# A stuck kernel I/O requires an explicit operator force-stop and crash recovery.
TimeoutStopSec=infinity
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateMounts=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/zxs /run/zxs -/srv/zxs/disks/P01
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
