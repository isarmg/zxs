[Unit]
Description=Check selected ZXS SMB installation sources (does not launch a daemon)

[Service]
Type=oneshot
User=@UID@
Group=@GID@
UMask=0077
# All new destination names are private to this unit's in-memory /run.
TemporaryFileSystem=/run:mode=0755
BindReadOnlyPaths=/var/lib/local-ops-helper/samba-instances/@INSTANCE@/domain.bound:/run/zxs-smb-held/domain.bound:norbind
BindReadOnlyPaths=/var/lib/local-ops-helper/samba-instances/@INSTANCE@/smb.conf:/run/zxs-smb-held/smb.conf:norbind
ExecStart=/usr/bin/python3 -I -S -B /usr/share/local-ops-helper/smb-host/check.py check @SYSTEM@ @POOL@ @INSTANCE@ @PROVISION@ @UID@ @GID@ @BOUND@ @SMBD@ @STORAGE@
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
LimitCORE=0
TimeoutStartSec=90s
TimeoutStopSec=10s
KillMode=control-group
SendSIGKILL=yes
Restart=no
StandardInput=null
StandardOutput=journal
StandardError=journal
