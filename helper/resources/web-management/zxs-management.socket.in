[Unit]
# Do not ask PID 1 to reuse a stale socket or recursively chown an occupied runtime directory.
AssertPathExists=!/run/zxs-management.sock
AssertPathIsSymbolicLink=!/run/zxs-management.sock
Description=ZXS management SCGI (local dedicated TLS peer only)

[Socket]
ListenStream=/run/zxs-management.sock
FileDescriptorName=zxs-management
Accept=no
Service=zxs-management.service
SocketUser=root
SocketGroup=@PROXY_GID@
SocketMode=0660
Backlog=16
RemoveOnStop=yes
