[Unit]
# Do not ask PID 1 to reuse a stale socket or recursively chown an occupied runtime directory.
AssertPathExists=!/run/zxs-management-https
AssertPathIsSymbolicLink=!/run/zxs-management-https
Description=Dedicated loopback-only TLS frontend for ZXS
Requires=zxs-management.socket
After=zxs-management.socket

[Service]
Type=exec
User=@PROXY_UID@
Group=@PROXY_GID@
UMask=0077
RuntimeDirectory=zxs-management-https
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/python3 -I -B /usr/share/local-ops-helper/web-management/profile.py frontend @SYSTEM@ @POOL@ @STORAGE_UID@ @STORAGE_GID@ @PROXY_UID@ @PROXY_GID@
ExecStart=/usr/sbin/nginx -e /dev/null -p /run/zxs-management-https/ -c /usr/share/local-ops-helper/web-management/nginx.conf
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
InaccessiblePaths=@SYSTEM@
LimitCORE=0
StandardInput=null
StandardOutput=null
StandardError=null
KillSignal=SIGQUIT
TimeoutStopSec=30s
