{
  "groups": {
    "ci-selection": {
      "reason": "CI routing, scope admission and execution evidence",
      "python_tests": [
        "test_development_ci",
        "test_targeted_ci",
        "test_workflows",
        "test_workflow_target_setup",
        "test_deletion_targeted_ci",
        "test_layout_targeted_ci",
        "test_offline_targeted_ci"
      ],
      "rust_targets": []
    },
    "held-directory-layout": {
      "reason": "Disk layout bytes, held directory identity, lease revocation, atomic replacement and repaired cross-directory recovery fixtures",
      "python_tests": [],
      "rust_targets": [
        {
          "package": "storage-engine",
          "manifest": "src/engine/Cargo.toml",
          "prefixes": [
            "persist::layout::tests::",
            "disk::owned::root_operation_tests::",
            "disk::owned::directory_entries_tests::",
            "disk::admission_tests::",
            "journal::writer_lifecycle_tests::",
            "journal::writer_tests::",
            "engine::membership_transition::readmission::",
            "engine::membership_transition::pending::terminal_resume::",
            "engine::membership_transition::pending::activation::backup::startup::resume::",
            "engine::backup_preparation::tests::",
            "engine::recovery_checkpoint::tests::",
            "engine::history_move_decision::choice::tests::",
            "engine::backup_preparation::native_control::databases::scoped::cutover::registration::target_seals::store::tests::",
            "engine::backup_preparation::native_control::databases::scoped::cutover::registration::target_writers::store::tests::",
            "container_storage::tests::cross_directory_recovery::"
          ],
          "max_tests": 187
        },
        {
          "package": "platform-io",
          "manifest": "src/platform/Cargo.toml",
          "prefixes": [
            "fs_safety::tests::",
            "fs_safety::unix::tests::"
          ],
          "max_tests": 100
        }
      ]
    },
    "paged-deletion-review": {
      "reason": "Paged deletion approval, canonical contract, HTTP authority and recoverable Web state",
      "python_tests": [],
      "rust_targets": [
        {
          "package": "storage-contract",
          "manifest": "src/contract/Cargo.toml",
          "prefixes": [
            "file_deletion_review::tests::"
          ],
          "max_tests": 80
        },
        {
          "package": "web-app",
          "manifest": "src/web/Cargo.toml",
          "prefixes": [
            "files::deletion::",
            "files::actions::operation::tests::"
          ],
          "max_tests": 80
        },
        {
          "package": "storage-server",
          "manifest": "src/server/Cargo.toml",
          "prefixes": [
            "http_soft_deletion::"
          ],
          "max_tests": 80,
          "kind": "test",
          "name": "phase1_smb_rpc",
          "features": [
            "core"
          ],
          "exact": [
            "soft_deletion::public_http_deletion_is_discoverable_and_undo_is_exact_authenticated_and_durable"
          ],
          "timeout_seconds": 900
        },
        {
          "package": "storage-server",
          "manifest": "src/server/Cargo.toml",
          "prefixes": [
            "http_file_deletion::projection::tests::"
          ],
          "max_tests": 80,
          "features": [
            "core"
          ]
        },
        {
          "package": "web-app",
          "manifest": "src/web/Cargo.toml",
          "mode": "check",
          "compile_target": "wasm32-unknown-unknown"
        }
      ]
    },
    "portable-path-consumers": {
      "reason": "PortablePath explicit text boundaries, canonical entries, namespace consumers and downstream compilation",
      "python_tests": [],
      "rust_targets": [
        {
          "package": "name-policy",
