          "features": [
            "core"
          ],
          "prefixes": [
            "engine_backend::admission::tests::",
            "engine_backend::file_manager::history_nodes::tests::",
            "engine_backend::read_projection::tests::"
          ],
          "exact": [
            "authorized_backend_tests::protected_overrides_preserve_identity_arguments_results_and_errors"
          ]
        },
        {
          "package": "storage-server",
          "manifest": "src/server/Cargo.toml",
          "max_tests": 160,
          "features": [
            "core"
          ],
          "kind": "test",
          "name": "http_engine",
          "prefixes": [
            "backup_namespace::"
          ]
        },
        {
          "package": "storage-server",
          "manifest": "src/server/Cargo.toml",
          "mode": "check",
          "default_features": false
        },
        {
          "package": "storage-helper",
          "manifest": "helper/Cargo.toml",
          "mode": "check",
          "kind": "bin",
          "name": "zxs-helper"
        },
        {
          "package": "web-app",
          "manifest": "src/web/Cargo.toml",
          "mode": "check"
        },
        {
          "package": "web-app",
          "manifest": "src/web/Cargo.toml",
          "mode": "check",
          "compile_target": "wasm32-unknown-unknown"
        },
        {
