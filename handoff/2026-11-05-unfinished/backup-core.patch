+fn copy_prepared(copies: &[Prepared]) -> Vec<Prepared> {
+    copies
+        .iter()
+        .map(|copy| Prepared {
+            version: copy.version.clone(),
+            placement: copy.placement.clone(),
+            source: copy.source.clone(),
+        })
+        .collect()
