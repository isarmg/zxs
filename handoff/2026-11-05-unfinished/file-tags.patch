+                } else {
+                    Vec::new()
+                };
+                let candidate =
+                    install_tag_decision(&mut fixture.engine, &next, &result, published, versions);
+                let payload_path = candidate.versions.first().map(|evidence| {
+                    let disk = fixture
+                        .engine
