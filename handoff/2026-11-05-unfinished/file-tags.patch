+                .then_some(())
+                .unwrap(),
+            3 => {
+                forged
+                    .operation_principals
+                    .insert(operation, "other".into());
+            }
+            4 => {
+                forged
+                    .operations
+                    .get_mut(&operation)
+                    .unwrap()
+                    .request_digest = "0".repeat(64)
+            }
+            5 => {
