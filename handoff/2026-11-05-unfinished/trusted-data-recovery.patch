+use super::*;
+use crate::Config;
+use std::{
+    fs,
+    os::unix::fs::{MetadataExt, PermissionsExt},
+};
+
+fn fixture() -> (tempfile::TempDir, Engine, PathBuf) {
+    let temp = tempfile::Builder::new()
+        .permissions(std::fs::Permissions::from_mode(0o700))
+        .tempdir()
+        .unwrap();
+    let mut config =
+        Config::development([temp.path().join("voter"), temp.path().join("retained/data")])
+            .unwrap();
+    config.disks[1].metadata_member = false;
+    let engine = Engine::initialize(&temp.path().join("system"), config).unwrap();
+    let manifest = temp.path().join("pre-loss.json");
+    (temp, engine, manifest)
+}
+
+#[test]
+fn core_recovery_rejects_system_equal_parent_or_child_before_candidate_io() {
+    let (_temp, engine, _) = fixture();
+    let metadata = engine.config().disks[0].root.clone();
+    let data = engine.recovery_data_roots().unwrap();
+    let original = fs::read(data[0].root.join("disk.json")).unwrap();
+    drop(engine);
+    for system in [
+        data[0].root.clone(),
+        data[0].root.parent().unwrap().to_path_buf(),
+        data[0].root.join("nested-system"),
+        data[0].root.join("."),
+    ] {
+        let error = Engine::restore_from_disks_and_data_roots(
+            &system,
+            std::slice::from_ref(&metadata),
+            &data,
+        )
+        .err()
+        .unwrap();
+        assert_eq!(error.code(), ErrorCode::ConfigInvalid);
+        assert!(!system.join("config.json").exists());
+        assert_eq!(fs::read(data[0].root.join("disk.json")).unwrap(), original);
+    }
+    for system in [metadata.clone(), metadata.join("nested-system")] {
+        assert_eq!(
+            Engine::restore_from_disks(&system, std::slice::from_ref(&metadata))
+                .err()
+                .unwrap()
+                .code(),
+            ErrorCode::ConfigInvalid
+        );
+    }
+    for system in [
+        data[0].root.clone(),
+        data[0].root.parent().unwrap().to_path_buf(),
+        data[0].root.join("system-without-data-selection"),
+    ] {
+        assert_eq!(
+            Engine::restore_from_disks(&system, std::slice::from_ref(&metadata))
+                .err()
+                .unwrap()
+                .code(),
+            ErrorCode::ConfigInvalid
+        );
+        assert!(!system.join("config.json").exists());
+    }
+}
+
+#[test]
+fn core_recovery_rejects_system_leaf_and_ancestor_symlinks() {
+    let (temp, engine, _) = fixture();
+    let metadata = engine.config().disks[0].root.clone();
+    let data = engine.config().disks[1].root.clone();
+    let original = fs::read(data.join("disk.json")).unwrap();
+    drop(engine);
+    let alias = temp.path().join("system-alias");
+    std::os::unix::fs::symlink(&data, &alias).unwrap();
+    for system in [alias.clone(), alias.join("missing/nested-system")] {
+        assert_eq!(
+            Engine::restore_from_disks(&system, std::slice::from_ref(&metadata))
+                .err()
+                .unwrap()
+                .code(),
+            ErrorCode::UnsafePath
+        );
+    }
+    assert_eq!(fs::read(data.join("disk.json")).unwrap(), original);
+    assert!(!data.join("missing").exists());
+    fs::rename(&data, temp.path().join("parked-data")).unwrap();
+    // A dangling leaf or ancestor is never treated as a missing SYSTEM.
+    for system in [alias.clone(), alias.join("missing/nested-system")] {
+        assert_eq!(
+            Engine::restore_from_disks(&system, std::slice::from_ref(&metadata))
+                .err()
+                .unwrap()
+                .code(),
+            ErrorCode::UnsafePath
+        );
+    }
+    assert!(
+        fs::symlink_metadata(&alias)
+            .unwrap()
+            .file_type()
+            .is_symlink()
+    );
+    assert!(!data.exists());
+}
+
+#[test]
+fn system_config_lookup_uses_held_directory_and_rejects_linked_config() {
+    let (temp, engine, _) = fixture();
+    let safe = temp.path().join("new-system");
+    let held = PrivateDirectory::create_all(&safe).unwrap();
+    let parked = temp.path().join("parked-system");
+    fs::rename(&safe, &parked).unwrap();
+    std::os::unix::fs::symlink(engine.root(), &safe).unwrap();
+    // The replacement points to an initialized SYSTEM, but cannot redirect this
+    // already held lookup. No path-based check or fallback is permitted here.
+    require_uninitialized_system(&held).unwrap();
+    std::os::unix::fs::symlink(
+        engine.root().join("config.json"),
+        parked.join("config.json"),
+    )
+    .unwrap();
+    assert_eq!(
+        require_uninitialized_system(&held).unwrap_err().code(),
+        ErrorCode::UnsafePath
+    );
+    assert_eq!(
+        require_uninitialized_system(&PrivateDirectory::open_existing(engine.root()).unwrap())
+            .unwrap_err()
+            .code(),
+        ErrorCode::AlreadyInitialized
+    );
+}
+
+#[test]
+fn delayed_system_creation_rejects_replaced_or_newly_linked_components() {
+    let (temp, engine, _) = fixture();
