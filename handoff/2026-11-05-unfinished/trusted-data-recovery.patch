+
+struct Fixture {
+    temp: tempfile::TempDir,
+    service: SetupRecovery,
+    data_id: String,
+    data_root: PathBuf,
+    manifest: PathBuf,
+}
+
+fn fixture() -> Fixture {
+    let temp = tempfile::Builder::new()
+        .permissions(std::fs::Permissions::from_mode(0o700))
+        .tempdir()
+        .unwrap();
+    let mut config =
+        Config::development((0..4).map(|n| temp.path().join(format!("disk-{n}")))).unwrap();
+    config.disks[3].metadata_member = false;
+    let mut engine = Engine::initialize(&temp.path().join("original-system"), config).unwrap();
+    engine
+        .persist_auth_state(
+            crate::auth::AuthStore::initialize(
+                &temp.path().join("snapshot-auth"),
+                "admin",
+                "long-test-password",
+            )
+            .unwrap()
+            .snapshot()
+            .unwrap(),
+            "system_auth",
+            storage_contract::OperationId::generate().unwrap(),
+        )
+        .unwrap();
+    let manifest = temp.path().join("pre-loss.json");
+    engine.export_recovery_data_manifest(&manifest).unwrap();
+    let data_id = engine.config().disks[3].disk_id.clone();
+    let old_data = engine.config().disks[3].root.clone();
+    let metadata = engine.config().disks[..3]
+        .iter()
+        .enumerate()
+        .map(|(n, disk)| (format!("voter-{n}"), disk.root.clone()))
+        .collect();
+    drop(engine);
+    let data_root = temp.path().join("relocated-data");
+    fs::rename(old_data, &data_root).unwrap();
+    let system = temp.path().join("restored-system");
+    let management = temp.path().join("new-management");
+    for path in [&system, &management] {
+        fs::create_dir(path).unwrap();
+        fs::set_permissions(path, fs::Permissions::from_mode(0o700)).unwrap();
+    }
+    let service = SetupRecovery::new(system, management, metadata)
+        .unwrap()
+        .with_recovery_data(
+            BTreeMap::from([("saved".to_owned(), manifest.clone())]),
+            BTreeMap::from([(data_id.clone(), data_root.clone())]),
+        )
+        .unwrap();
+    Fixture {
+        temp,
+        service,
+        data_id,
+        data_root,
+        manifest,
+    }
