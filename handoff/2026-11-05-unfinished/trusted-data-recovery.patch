+        disk_ids: metadata.iter().map(|id| (*id).to_owned()).collect(),
+        data_recovery: Some(RecoveryDataSelection {
+            manifest_id: "saved".into(),
+            disk_ids: vec![data_id.to_owned()],
+        }),
+        accept_stale_credentials: false,
+    }
