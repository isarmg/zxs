+#[test]
+#[ignore = "requires the external strace recovery-data-probe.sh observer"]
+fn recovery_preflight_forbids_candidate_syscalls() {
+    use std::process::Command;
+    let base = PathBuf::from(std::env::var_os("ZXS_RECOVERY_PROBE_BASE").unwrap());
+    let action = std::env::var("ZXS_RECOVERY_PROBE_ACTION").unwrap();
+    let entry = std::env::var("ZXS_RECOVERY_PROBE_ENTRY").unwrap();
+    let present = std::env::var("ZXS_RECOVERY_PROBE_PRESENT").unwrap() == "1";
+    let candidate = base.join("retained/forbidden-data-candidate-9c79f5f8");
+    let second = base.join("second-forbidden-data-candidate-9c79f5f8");
+    let metadata: Vec<_> = (0..3).map(|n| base.join(format!("voter-{n}"))).collect();
+    let mut config = Config::development(
+        metadata
+            .iter()
+            .cloned()
+            .chain([candidate.clone(), second.clone()]),
+    )
+    .unwrap();
+    config.disks[3].metadata_member = false;
+    config.disks[4].metadata_member = false;
+    let engine = Engine::initialize(&base.join("original-system"), config).unwrap();
+    let manifest_path = base.join("pre-loss.json");
+    let manifest = engine
+        .export_recovery_data_manifest(&manifest_path)
+        .unwrap();
+    let data_id = engine.config().disks[3].disk_id.clone();
+    let roots = manifest
+        .data_roots(&BTreeMap::from([(data_id.clone(), candidate.clone())]))
+        .unwrap();
+    let second_id = engine.config().disks[4].disk_id.clone();
+    let second_roots = manifest
+        .data_roots(&BTreeMap::from([(second_id.clone(), second.clone())]))
+        .unwrap();
+    drop(engine);
+    if !present {
+        fs::rename(&candidate, base.join("parked-data")).unwrap();
+    }
+    let alias = base.join("system-alias-4ce3b0");
+    let alias_action = matches!(
+        action.as_str(),
+        "system-symlink-leaf" | "system-symlink-ancestor"
+    );
+    if alias_action {
+        std::os::unix::fs::symlink(&candidate, &alias).unwrap();
+    }
+    let system = match action.as_str() {
+        "missing-quorum" => base.join("restored-system"),
+        "overlap-same" => candidate.clone(),
+        "overlap-parent" => candidate.parent().unwrap().to_path_buf(),
+        "overlap-child" => candidate.join("nested-system"),
+        "unlisted-system" | "unlisted-with-selection" => candidate.clone(),
+        "system-symlink-leaf" => alias.clone(),
+        "system-symlink-ancestor" => alias.join("missing/nested-system"),
+        other => panic!("unknown probe action {other}"),
+    };
+    let expected = if action == "missing-quorum" {
+        ErrorCode::ConfigConflict
+    } else if alias_action {
+        ErrorCode::UnsafePath
+    } else {
+        ErrorCode::ConfigInvalid
+    };
+    let selected_metadata = if action == "missing-quorum" {
+        &metadata[..1]
+    } else {
+        metadata.as_slice()
+    };
+    let selected_data = match action.as_str() {
+        "unlisted-system" | "system-symlink-leaf" | "system-symlink-ancestor" => &[][..],
+        "unlisted-with-selection" => second_roots.as_slice(),
+        _ => roots.as_slice(),
+    };
+    println!("ZXS_RECOVERY_PROBE_REJECT_BEGIN");
+    let code = match entry.as_str() {
+        "engine" => {
+            Engine::restore_from_disks_and_data_roots(&system, selected_metadata, selected_data)
+                .err()
+                .unwrap()
+                .code()
+        }
+        "cli" => {
+            let mut command = Command::new(std::env::var_os("ZXS_RECOVERY_PROBE_RESCUE").unwrap());
+            command
+                .arg("--root")
+                .arg(&system)
+                .args(["restore-system", "--disks"])
+                .args(selected_metadata);
+            if !selected_data.is_empty() {
+                command.arg("--data-manifest").arg(&manifest_path);
+                for selected in selected_data {
+                    command.arg("--data-root").arg(format!(
+                        "{}={}",
+                        selected.identity.disk_id,
+                        selected.root.display()
+                    ));
+                }
+            }
+            let output = command.output().unwrap();
+            assert_eq!(output.status.code(), Some(1), "{output:?}");
+            assert!(
+                String::from_utf8_lossy(&output.stderr).contains(&expected.to_string()),
+                "{output:?}"
+            );
+            expected
+        }
+        other => panic!("unknown probe entry {other}"),
+    };
+    println!("ZXS_RECOVERY_PROBE_REJECT_END");
+    assert_eq!(code, expected);
+    // The observer must see both the real first stat and the exact DiskRoot
+    // open implementation, including an ENOENT candidate. No libc shim is used.
+    println!("ZXS_RECOVERY_PROBE_CALIBRATE_BEGIN");
+    let observed = fs::symlink_metadata(&candidate);
+    let opened = crate::disk::DiskRoot::open(&candidate);
+    if alias_action {
+        // Trace the alias spelling too: strace cannot be assumed to expand
+        // intermediate symlinks for path-based stat/open calls.
+        assert_eq!(fs::metadata(&alias).is_ok(), present);
+        assert_eq!(fs::File::open(&alias).is_ok(), present);
+    }
+    println!("ZXS_RECOVERY_PROBE_CALIBRATE_END");
+    assert_eq!(observed.is_ok(), present);
+    assert_eq!(opened.is_ok(), present);
+    drop(opened);
+    println!("ZXS_RECOVERY_PROBE_COMPLETE entry={entry} action={action} present={present}");
+}
