+//! Recovery-only local bindings. No constructor or selection probes a data root.
+use super::{ApiError, PathBuf, SetupRecovery, engine_error, valid_local_setup_id};
+use data_serialization::Deserialize;
+use std::{
+    collections::BTreeMap,
+    path::{Component, Path},
+};
+use storage_engine::{RecoveryDataManifest, RecoveryDataRoot};
+
+#[derive(Deserialize)]
+#[serialization(deny_unknown_fields)]
+pub struct RecoveryDataSelection {
+    pub manifest_id: String,
+    pub disk_ids: Vec<String>,
+}
+
+impl SetupRecovery {
+    /// Immutable trusted-local paths only. Manifests must be original exports
+    /// retained before SYSTEM loss; current discovery observations cannot replace
+    /// them. This stores paths without opening files or inspecting candidate roots.
+    pub fn with_recovery_data(
+        mut self,
+        manifests: BTreeMap<String, PathBuf>,
+        roots: BTreeMap<String, PathBuf>,
+    ) -> Result<Self, ApiError> {
+        for (id, path) in &manifests {
+            if !valid_local_setup_id(id) {
+                return Err(ApiError::invalid(
+                    "invalid local recovery manifest identifier",
+                ));
+            }
+            absolute(path)?;
+        }
+        for (id, path) in &roots {
+            storage_contract::validate_id(id, "disk").map_err(ApiError::invalid_source)?;
+            absolute(path)?;
+            if [&self.data_root, &self.management_root]
+                .into_iter()
+                .chain(self.disks.values())
+                .any(|other| path.starts_with(other) || other.starts_with(path))
+            {
+                return Err(ApiError::invalid(
+                    "data recovery roots overlap system or metadata roots",
+                ));
+            }
+        }
+        self.recovery_data_manifests = manifests;
+        self.recovery_data_roots = roots;
+        Ok(self)
+    }
+
+    pub(super) fn selected_recovery_data(
+        &self,
+        selection: Option<&RecoveryDataSelection>,
+    ) -> Result<Vec<RecoveryDataRoot>, ApiError> {
+        let Some(selection) = selection else {
+            return Ok(Vec::new());
+        };
+        if selection.disk_ids.is_empty() || selection.disk_ids.len() > 32 {
+            return Err(ApiError::invalid(
+                "select between one and 32 explicitly authorized data roots",
+            ));
+        }
+        let manifest = self
+            .recovery_data_manifests
+            .get(&selection.manifest_id)
+            .ok_or_else(|| ApiError::invalid("recovery manifest is not locally authorized"))?;
+        let mut selected = BTreeMap::new();
+        for id in &selection.disk_ids {
+            let root = self
+                .recovery_data_roots
+                .get(id)
+                .ok_or_else(|| ApiError::invalid("recovery data root is not locally authorized"))?;
+            if selected.insert(id.clone(), root.clone()).is_some() {
+                return Err(ApiError::invalid("duplicate recovery data identifier"));
+            }
+        }
+        let excluded: Vec<_> = [&self.data_root, &self.management_root]
+            .into_iter()
+            .chain(self.disks.values())
+            .chain(self.recovery_data_roots.values())
+            .cloned()
+            .collect();
+        RecoveryDataManifest::read_trusted(manifest, &excluded)
+            .and_then(|manifest| manifest.data_roots(&selected))
+            .map_err(engine_error)
+    }
+}
+
+fn absolute(path: &Path) -> Result<(), ApiError> {
+    if !path.is_absolute()
+        || path
+            .components()
+            .any(|part| !matches!(part, Component::RootDir | Component::Normal(_)))
+    {
+        return Err(ApiError::invalid(
+            "recovery sources require absolute paths without traversal",
+        ));
+    }
+    Ok(())
+}
+
