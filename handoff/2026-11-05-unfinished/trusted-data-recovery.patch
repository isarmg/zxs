+#[test]
+fn configuring_data_roots_performs_no_candidate_io() {
+    let f = fixture();
+    let missing = f.temp.path().join("unmounted-data");
+    let service = f
+        .service
+        .with_recovery_data(
+            BTreeMap::from([("missing-file".into(), f.temp.path().join("missing.json"))]),
