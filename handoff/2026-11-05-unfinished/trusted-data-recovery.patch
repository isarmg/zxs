+#[test]
+fn service_never_accepts_http_physical_identity_or_unknown_local_sources() {
+    for field in ["device", "inode", "root", "identity"] {
+        let mut value = json_codec::json!({
+            "disk_ids": ["voter-0"],
+            "data_recovery": {"manifest_id":"saved", "disk_ids":["disk_test"]}
+        });
+        value["data_recovery"][field] = "self-certified".into();
+        assert!(
+            json_codec::from_value::<RestoreRequest>(value).is_err(),
+            "{field}"
+        );
+    }
+    let f = fixture();
+    for selection in [
+        RecoveryDataSelection {
+            manifest_id: "unknown".into(),
+            disk_ids: vec![f.data_id.clone()],
+        },
+        RecoveryDataSelection {
+            manifest_id: "saved".into(),
+            disk_ids: vec!["unknown".into()],
+        },
+        RecoveryDataSelection {
+            manifest_id: "saved".into(),
+            disk_ids: vec![f.data_id.clone(), f.data_id.clone()],
+        },
+    ] {
+        assert!(f.service.selected_recovery_data(Some(&selection)).is_err());
+    }
+    assert!(!f.service.data_root.join("config.json").exists());
+}
