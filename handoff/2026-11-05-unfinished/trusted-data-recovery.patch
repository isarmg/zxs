+#!/usr/bin/env bash
+# Observe actual syscalls, including rustix direct syscalls; no preload or product hook.
+set -euo pipefail
+engine="$(realpath "${1:?pass the storage-engine libtest binary}")"
+rescue="$(realpath "${2:?pass the zxs-rescue binary}")"
+evidence="${3:?pass an unused absolute evidence directory; traces are retained}"
+[[ "$evidence" = /* ]] || { echo "Evidence directory must be absolute" >&2; exit 1; }
+command -v strace >/dev/null || { echo "strace is required for syscall evidence" >&2; exit 1; }
+command -v python3 >/dev/null
+name=recovery_data::tests::recovery_preflight_forbids_candidate_syscalls
+listed="$("$engine" --list --ignored --exact "$name")"
+[[ "$(grep -Fxc "$name: test" <<< "$listed")" = 1 ]] || {
+  echo "The exact current ignored recovery syscall test is missing" >&2
+  exit 1
+}
+mkdir -m 700 "$evidence"
+for entry in engine cli; do
+  for action in missing-quorum overlap-same overlap-parent overlap-child unlisted-system unlisted-with-selection system-symlink-leaf system-symlink-ancestor; do
+    for present in 0 1; do
+      base="$evidence/$entry-$action-$present"
+      mkdir -m 700 "$base"
+      env ZXS_RECOVERY_PROBE_BASE="$base" ZXS_RECOVERY_PROBE_ENTRY="$entry" \
+        ZXS_RECOVERY_PROBE_ACTION="$action" ZXS_RECOVERY_PROBE_PRESENT="$present" \
+        ZXS_RECOVERY_PROBE_RESCUE="$rescue" \
+        strace -f -qq -yy -s 4096 -e trace=%file,fstat,write -o "$base/syscalls" \
+        "$engine" --ignored --exact --nocapture --test-threads=1 --color never "$name" \
+        | tee "$base/result"
+      grep -Fq "ZXS_RECOVERY_PROBE_COMPLETE entry=$entry action=$action" "$base/result"
+      grep -Eq '^test result: ok\. 1 passed; 0 failed; 0 ignored; 0 measured; [0-9]+ filtered out;' "$base/result"
+      python3 - "$base/syscalls" "$action" <<'PY'
+import re
+import sys
+
+needle = "forbidden-data-candidate-9c79f5f8"
+alias = "system-alias-4ce3b0"
+alias_action = sys.argv[2] in {"system-symlink-leaf", "system-symlink-ancestor"}
+markers = {
+    "ZXS_RECOVERY_PROBE_REJECT_BEGIN": (None, "reject"),
+    "ZXS_RECOVERY_PROBE_REJECT_END": ("reject", None),
+    "ZXS_RECOVERY_PROBE_CALIBRATE_BEGIN": (None, "calibrate"),
+    "ZXS_RECOVERY_PROBE_CALIBRATE_END": ("calibrate", None),
+}
+seen = {marker: 0 for marker in markers}
+events = {"reject": [], "calibrate": []}
+alias_events = {"reject": [], "calibrate": []}
+syscall = re.compile(r"\b(open(?:64|at2?)?|(?:new)?f?stat(?:at64|at|64|x)?|lstat(?:64)?)\(")
+phase = None
+with open(sys.argv[1], encoding="utf-8") as source:
+    for line in source:
+        if re.search(r"\bwrite\(", line):
+            for marker, (before, after) in markers.items():
+                if marker in line:
+                    if phase != before:
+                        raise SystemExit(f"Invalid trace phase for {marker}: {line}")
+                    seen[marker] += 1
+                    phase = after
+        found = syscall.search(line)
+        if phase and found and needle in line:
+            events[phase].append((found.group(1), line.rstrip()))
+        if phase and found and alias in line:
+            alias_events[phase].append((found.group(1), line.rstrip()))
+if phase is not None or any(count != 1 for count in seen.values()):
+    raise SystemExit(f"Incomplete or duplicate probe boundaries: {seen}")
+if events["reject"]:
+    raise SystemExit("Forbidden candidate syscall before rejection:\n" + "\n".join(line for _, line in events["reject"]))
+calibrated = {kind for kind, _ in events["calibrate"]}
+if not any(kind.startswith("open") for kind in calibrated) or not any("stat" in kind for kind in calibrated):
+    raise SystemExit(f"Observer did not see both real candidate stat and DiskRoot open: {calibrated}")
+if alias_action:
+    if not alias_events["reject"]:
+        raise SystemExit("The alias rejection was not observed")
+    for kind, line in alias_events["reject"]:
+        # Only an exact single component relative to the already-held parent,
+        # with NOFOLLOW|DIRECTORY and kernel rejection, can inspect the link
+        # without dereferencing it. NOFOLLOW on a multi-component path is not
+        # enough; stat(alias/child) can follow an intermediate link silently.
+        safe = (
+            kind == "openat"
+            and re.search(r'openat\(\d+<[^>]+>, "' + re.escape(alias) + r'", ', line)
+            and "O_NOFOLLOW" in line
+            and "O_DIRECTORY" in line
+            and re.search(r'= -1 (ENOTDIR|ELOOP)\b', line)
+        )
+        if not safe:
+            raise SystemExit("Following or unproved alias access before rejection:\n" + line)
+    alias_calibrated = {kind for kind, _ in alias_events["calibrate"]}
+    if not any(kind.startswith("open") for kind in alias_calibrated) or not any("stat" in kind for kind in alias_calibrated):
+        raise SystemExit(f"Observer missed following alias stat/open calibration: {alias_calibrated}")
+print("PROVEN: zero candidate stat/open during rejection; real stat and DiskRoot open calibration observed")
+PY
+    done
+  done
+done
+printf 'Recovery syscall traces retained at %s\n' "$evidence"
