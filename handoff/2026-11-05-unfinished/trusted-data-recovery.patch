@@ -0,0 +1,38 @@
+# 显式 data-only SYSTEM 恢复的可信清单
+
+## 实际入口
+
+- `Engine::export_recovery_data_manifest` 从健康 Engine 的 `recovery_data_roots()` 导出已持有、已准入的登记和物理绑定。
+- `zxs-rescue export-recovery-data --output FILE` 是灾前真实导出入口；文件不得覆盖，不创建父目录，父目录须由当前账户拥有且为 0700。
+- `zxs-rescue restore-system --disks ... --data-manifest FILE --data-root DISK_ID=/absolute/path` 明确选择已保存身份及现有路径。
+- 服务本地 `--recovery-data-manifest ID=FILE`、`--recovery-data-root DISK_ID=PATH` 只保存配置，不访问数据根。现有 restore-system HTTP 请求的可选 `data_recovery` 只选择本地 manifest ID 和 disk IDs。
+- 两条恢复入口共用 `restore_from_disks_and_data_roots_with_workspace_limits`，不引入第二套 quorum、设备身份或代际验证。
+
+## 信任与访问边界
+
+当前清单格式为 `pre-loss-data-bindings`，最多 1 MiB、4096 条；严格拒绝重复/未知字段、不支持格式、重复登记/槽/物理身份和跨池绑定。格式只含 pool/disk/slot/generation/device/inode，没有自动访问的路径。
+
+可信来源是灾前已准入 held handles 与 SYSTEM 外独立保留的原始导出。私有 0600、单链接、无符号链接、可信目录祖先和有界读取保护本地加载，但不构成灾前来源的密码学证明。管理员必须可信保管；程序绝不从候选 seal、扫描器、启动时重新统计值或任意 HTTP 身份字段制造预期绑定。没有清单时保留 metadata-only 恢复。
+
+路径单独显式选择；`preflight_recovery_paths` 纯词法检查 SYSTEM 与所有显式 metadata/data 根，拒绝相同及任一方向的父子重叠、父级穿越。核心首步检查显式输入，CLI 在读取清单之前检查；完成 metadata 权威选择及显式搬家投影后，核心先纯检查全部认证登记根，尚未打开任何 data root。SYSTEM 每个路径分量使用 `DIRECTORY|NOFOLLOW` 打开，叶子或祖先符号链接（包括悬空链接）都明确拒绝，不能凭词法检查后再裸路径 stat。缺失 SYSTEM 在数据身份验证后才用同样逐分量原语创建，保留全祖先 fsync；已有 SYSTEM 在前后两个 held fd 间比较 dev/inode，config 存在性只通过 held fd 的 no-symlink openat2 判断。这样 metadata-only 请求也不能把未列旧数据根冒充 SYSTEM。AlreadyInitialized 的判定因此晚于恢复输入的只读核验，但早于任何 SYSTEM/控制写入。两层纯路径检查都不通过 canonicalize/stat/open 探测候选；SYSTEM 的安全打开不能跟随链接到候选，也不对其链接目标做 canonicalize。清单文件与 SYSTEM/候选根的重叠另行拒绝。未选择条目不会成为 I/O 授权。核心先选真实固定 metadata 多数，再验证当前非投票登记、原 device/inode、当前 seal、本地锚及 portable 证据。数据根不计票，stop/detach/错误角色/身份重绑定仍拒绝。获得 held handles 后再次验证，随后依次 workspace preflight、bootstrap、exclusion 与 replay。原有身份认证、CSRF/Origin、生命周期 owner 和发布前撤权检查没有更改。
+
+导出只包含当前可用且已准入的非投票根，收据列明实际 disk IDs。它不是全盘覆盖/健康证明，不提供 Disabled readmission、设备替换、自动挂载或凭据重置。
+
+## 回归源码与验收状态
+
+- `test/engine/unit/recovery_data_tests.rs`：导出原身份、重定位恢复与冷开、不覆盖、禁止内部备份、私有/链接/严格格式拒绝、无绑定不回退、改写候选 seal 仍拒绝、缺固定 Q 先于数据根访问。
+- `test/rescue/startup.rs`：真实导出 CLI → SYSTEM 丢失 → 数据路径移动 → 恢复 CLI → 冷开；`test/rescue/unit/recovery_data_tests.rs` 与 `main/args_tests.rs` 覆盖纯选择与参数约束。
+- `test/server/unit/setup_recovery/recovery_data_tests.rs`：服务接线、auth snapshot 保留、未选清单不读取、未知本地源/HTTP 自报身份拒绝、缺 Q 及配置阶段不访问数据根；`test/server/unit/main_tests.rs` 覆盖本地选项。
+- core 与 CLI 另有相同/父/子/`.` 等价路径拒绝回归；CLI 使用不存在清单证明拒绝先于清单读取。core 还覆盖 SYSTEM 叶子/祖先链接、悬空链接、held SYSTEM 名称被替换后 config 查找仍不重开路径、config 本身为链接、延迟创建前已有目录被替换或缺失祖先变成链接，以及多层缺失 SYSTEM 祖先的成功恢复。
+
+真实零 stat/open 验收入口：
+
+```sh
+bash test/engine/unit/recovery-data-probe.sh ENGINE_LIBTEST ZXS_RESCUE /absolute/new-private-evidence
+```
+
+须传同一组合树的 engine libtest 与 rescue 二进制，并已安装 strace、python3。脚本运行精确 ignored 场景，使用 `strace -f -yy` 观察真实内核 stat/open，包括 rustix direct syscall，无需 libc 特性或预加载替换。Engine/CLI、缺 Q/相同/父/子重叠/未列数据根冒充 SYSTEM/未列 A 冒充 SYSTEM 且另选 B/叶子链接/祖先链接、候选存在/缺失组成 32 个场景。拒绝窗口必须零候选 stat/open；随后必须实际观察 `symlink_metadata` 和同一 `DiskRoot::open` 的正校准，缺失标记或任一校准未观察到都失败。链接场景另按 alias 名称匹配，因为 strace 不保证展开中间链接目标：拒绝窗口只允许对该单分量的 `openat` 带 `DIRECTORY|NOFOLLOW` 并返回 ENOTDIR/ELOOP，任何经 alias 的 stat、多分量 open 或成功 open 都失败；正校准必须真实看到跟随 alias 的 stat 和 open。脚本在指定的新私有目录保留原始 syscall/result，不删除证据。它不把“路径未创建”或某个错误码当作零探测的充分证据。
+
+本次仅执行指定 Rust 文件的 rustfmt 和 `git diff --check`，未编译、测试、运行上述 strace 门禁、Clippy、CI、真实部署或物理掉电验证。集成后须分别执行 engine、rescue 与 server 的对应目标，且保留完整组合 CI；源码中的拒绝测试不是已经通过的系统调用隔离或生产恢复演练证明。
+
+清单生成/验证为 O(N log N)，选择为 O(N log N + M log N)，N 为导出条目、M 为显式根数；内存受清单字节数和条目数限制。导出复用 AtomicFile 的文件同步与 no-clobber 发布、目录同步屏障；恢复读取清单不新增磁盘写入或削减核心屏障。
diff --git a/src/engine/src/recovery_data.rs b/src/engine/src/recovery_data.rs
new file mode 100644
index 00000000..d87f7d83
--- /dev/null
+++ b/src/engine/src/recovery_data.rs
@@ -0,0 +1,307 @@
+//! Operator-retained, pre-loss physical bindings. No candidate root supplies authority.
+use crate::{DiskRegistrationIdentity, Engine, Error, ErrorCode, RecoveryDataRoot, Result};
+use data_serialization::{Deserialize, Serialize};
+use platform_io::fs_safety::{
+    AtomicFile, EntryName, PrivateDirectory,
+    linux::{MountPolicy, OpenAt2Root, open_private_regular},
+};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    os::unix::fs::MetadataExt,
+    path::{Path, PathBuf},
+};
+
+const MAX_MANIFEST_BYTES: usize = 1024 * 1024;
+const MAX_BINDINGS: usize = 4096;
+
+/// Pure recovery-path preflight, before even checking SYSTEM/config.json.
+/// This rejects equality and either direction of containment after lexical
+/// normalization, without canonicalizing, opening or stating a storage root.
+/// It grants no I/O authority and does not replace quorum or held-root checks.
+///
+/// # Errors
+/// Rejects parent traversal and overlap between SYSTEM and any explicitly
+/// selected metadata or data root. Relative paths use the current directory.
+pub fn preflight_recovery_paths(system: &Path, storage_roots: &[PathBuf]) -> Result<()> {
+    let system = crate::disk::absolute_path(system)?;
+    for storage in storage_roots {
+        let storage = crate::disk::absolute_path(storage)?;
+        if system.starts_with(&storage) || storage.starts_with(&system) {
+            return Err(Error::new(
+                ErrorCode::ConfigInvalid,
+                "storage and system recovery directories must not overlap",
+            ));
+        }
+    }
+    Ok(())
+}
+
+/// Open every SYSTEM component with DIRECTORY | NOFOLLOW. A missing component
+/// is not created yet; a symlink (including a dangling one or an ancestor) is
+/// an error, never an absent SYSTEM. Do not inspect config through a bare path.
+pub(crate) fn open_recovery_system(root: &Path) -> Result<RecoverySystem> {
+    let path = crate::disk::absolute_path(root)?;
+    let existing = match PrivateDirectory::open_existing(&path) {
+        Ok(directory) => Some(OpenAt2Root::from_private_directory(
+            directory,
+            MountPolicy::SameMount,
+        )?),
+        Err(platform_io::fs_safety::Error::Io(error))
+            if error.kind() == std::io::ErrorKind::NotFound =>
+        {
+            None
+        }
+        Err(error) => return Err(error.into()),
+    };
+    Ok(RecoverySystem { path, existing })
+}
+
+pub(crate) struct RecoverySystem {
+    path: PathBuf,
+    existing: Option<OpenAt2Root>,
+}
+
+impl RecoverySystem {
+    /// Preserve the full existing mkdir/fsync protocol after data admission.
+    /// Reopening each component remains NOFOLLOW; compare only held identities,
+    /// never a path-based stat that could follow a replaced ancestor.
+    pub(crate) fn create(self) -> Result<PrivateDirectory> {
+        let directory = PrivateDirectory::create_all(&self.path)?;
+        let current = OpenAt2Root::from_private_directory(directory, MountPolicy::SameMount)?;
+        if self
+            .existing
+            .as_ref()
+            .is_some_and(|old| old.identity() != current.identity())
+        {
+            return Err(platform_io::fs_safety::Error::IdentityChanged(self.path).into());
+        }
+        let directory = PrivateDirectory::from_directory(current.into_directory(), self.path)?;
+        require_uninitialized_system(&directory)?;
+        Ok(directory)
+    }
+}
+
+/// The held SYSTEM descriptor, not its diagnostic path, owns this lookup.
+pub(crate) fn require_uninitialized_system(directory: &PrivateDirectory) -> Result<()> {
+    match open_private_regular(directory, &EntryName::new("config.json")?) {
+        Ok(_) => Err(Error::new(
+            ErrorCode::AlreadyInitialized,
+            "restore requires a new system state directory",
+        )),
+        Err(platform_io::fs_safety::Error::Io(error))
+            if error.kind() == std::io::ErrorKind::NotFound =>
+        {
+            Ok(())
+        }
+        Err(error) => Err(error.into()),
+    }
+}
+
+#[derive(Deserialize, Serialize)]
+enum ManifestFormat {
+    #[serialization(rename = "pre-loss-data-bindings")]
+    PreLossDataBindings,
+}
+
+#[derive(Deserialize, Serialize)]
+#[serialization(deny_unknown_fields)]
+struct Binding {
+    identity: DiskRegistrationIdentity,
+    #[serialization(with = "storage_contract::u64_string")]
+    device: u64,
+    #[serialization(with = "storage_contract::u64_string")]
+    inode: u64,
+}
+
+#[derive(Deserialize, Serialize)]
+#[serialization(deny_unknown_fields)]
+struct Document {
+    format: ManifestFormat,
+    pool_id: String,
+    bindings: Vec<Binding>,
+}
+
+/// Validated bindings loaded from a separately trusted pre-loss export.
+/// File ownership protects local admission; it cannot prove when somebody wrote
+/// a file. The operator must retain the original export outside SYSTEM and data
+/// roots. A manifest copied or synthesized from a recovery candidate is not trusted.
+/// Paths are deliberately absent: selecting this file never selects a data root.
+pub struct RecoveryDataManifest {
+    document: Document,
+}
+
+impl RecoveryDataManifest {
+    fn validate(document: Document) -> Result<Self> {
+        storage_contract::validate_id(&document.pool_id, "pool")?;
+        if document.bindings.len() > MAX_BINDINGS {
+            return Err(Error::new(
+                ErrorCode::ResourceLimit,
+                "too many recovery data bindings",
+            ));
+        }
+        let mut ids = BTreeSet::new();
+        let mut slots = BTreeSet::new();
+        let mut physical = BTreeSet::new();
+        for binding in &document.bindings {
+            let identity = &binding.identity;
+            storage_contract::validate_id(&identity.disk_id, "disk")?;
+            name_policy::validate_slot(&identity.slot_id)?;
+            if identity.pool_id != document.pool_id
+                || identity.binding_generation == 0
+                || !ids.insert(&identity.disk_id)
+                || !slots.insert(identity.slot_id.to_ascii_lowercase())
+                || !physical.insert((binding.device, binding.inode))
+            {
+                return Err(Error::new(
+                    ErrorCode::ConfigConflict,
+                    "conflicting recovery data bindings",
+                ));
+            }
+        }
+        Ok(Self { document })
+    }
+
+    /// Read an explicitly trusted external file, never a path from an HTTP request.
+    /// `excluded_roots` must include SYSTEM and all locally authorized candidate
+    /// roots. The overlap check is lexical and performs no candidate-root I/O.
+    /// Errors retain strict JSON, ownership, link, size and filesystem causes.
+    pub fn read_trusted(path: &Path, excluded_roots: &[PathBuf]) -> Result<Self> {
+        let (directory, name) = external_file(path, excluded_roots)?;
+        let file = open_private_regular(&directory, &name)?;
+        let identity = file.metadata()?;
+        if identity.uid() != rustix::process::geteuid().as_raw()
+            || identity.mode() & 0o7777 != 0o600
+        {
+            return Err(platform_io::fs_safety::Error::UnsafePermissions(
+                directory.path().join(name.as_path()),
+            )
+            .into());
+        }
+        let bytes = crate::disk::read_file_bytes(file, MAX_MANIFEST_BYTES)?;
+        Self::validate(storage_contract::decode_strict(&bytes)?)
+    }
+
+    pub fn pool_id(&self) -> &str {
+        &self.document.pool_id
+    }
+
+    /// Exported identities only, not a promise that every configured data disk was available.
+    pub fn disk_ids(&self) -> impl Iterator<Item = &str> {
+        self.document
+            .bindings
+            .iter()
+            .map(|binding| binding.identity.disk_id.as_str())
+    }
+
+    /// Bind only explicitly selected paths to previously saved physical identities.
+    /// This is pure: quorum selection and all actual root validation remain in Engine.
+    pub fn data_roots(
+        &self,
+        selected: &BTreeMap<String, PathBuf>,
+    ) -> Result<Vec<RecoveryDataRoot>> {
+        let by_id: BTreeMap<_, _> = self
+            .document
+            .bindings
+            .iter()
+            .map(|binding| (binding.identity.disk_id.as_str(), binding))
+            .collect();
+        let mut unique_paths = BTreeSet::new();
+        selected
+            .iter()
+            .map(|(id, path)| {
+                let binding = by_id.get(id.as_str()).ok_or_else(|| {
+                    Error::new(
+                        ErrorCode::ConfigConflict,
+                        "selected data disk has no trusted pre-loss binding",
+                    )
+                })?;
+                if !path.is_absolute() {
+                    return Err(Error::new(
+                        ErrorCode::UnsafePath,
+                        "explicit data roots must be absolute",
+                    ));
+                }
+                let root = crate::disk::absolute_path(path)?;
+                if !unique_paths.insert(root.clone()) {
+                    return Err(Error::new(
+                        ErrorCode::ConfigConflict,
+                        "duplicate explicit data root",
+                    ));
+                }
+                Ok(RecoveryDataRoot {
+                    root,
+                    identity: binding.identity.clone(),
+                    device: binding.device,
+                    inode: binding.inode,
+                })
+            })
+            .collect()
+    }
+
+    fn encode(&self) -> Result<Vec<u8>> {
+        let bytes = json_codec::to_vec(&self.document)?;
+        if bytes.len() > MAX_MANIFEST_BYTES {
+            return Err(Error::new(
+                ErrorCode::ResourceLimit,
+                "recovery data manifest exceeds byte limit",
+            ));
+        }
+        Ok(bytes)
+    }
+}
+
+impl Engine {
+    /// Save physical bindings from this healthy, already admitted Engine into a
+    /// new external private file. No seal or expected identity is read from a
+    /// user-supplied candidate. Unavailable data members are not exported.
+    /// Stop the daemon before invoking this through the offline rescue tool.
+    /// Errors never overwrite an existing export or create its parent directory.
+    pub fn export_recovery_data_manifest(&self, path: &Path) -> Result<RecoveryDataManifest> {
+        self.require_write()?;
+        let bindings = self
+            .recovery_data_roots()?
+            .into_iter()
+            .map(|root| Binding {
+                identity: root.identity,
+                device: root.device,
+                inode: root.inode,
+            })
+            .collect();
+        let manifest = RecoveryDataManifest::validate(Document {
+            format: ManifestFormat::PreLossDataBindings,
+            pool_id: self.config().pool_id.clone(),
+            bindings,
+        })?;
+        let excluded: Vec<_> = std::iter::once(self.root().to_path_buf())
+            .chain(self.config().disks.iter().map(|disk| disk.root.clone()))
+            .collect();
+        let (directory, name) = external_file(path, &excluded)?;
+        AtomicFile::create(&directory, &name, &manifest.encode()?)?;
+        Ok(manifest)
+    }
+}
+
+fn external_file(path: &Path, excluded_roots: &[PathBuf]) -> Result<(PrivateDirectory, EntryName)> {
+    let path = crate::disk::absolute_path(path)?;
+    for excluded in excluded_roots {
+        let excluded = crate::disk::absolute_path(excluded)?;
+        if path.starts_with(&excluded) || excluded.starts_with(&path) {
+            return Err(Error::new(
+                ErrorCode::UnsafePath,
+                "recovery manifest must be outside SYSTEM and candidate roots",
+            ));
+        }
+    }
+    let parent = path
+        .parent()
+        .ok_or_else(|| Error::new(ErrorCode::UnsafePath, "manifest parent is missing"))?;
+    let name = EntryName::new(
+        path.file_name()
+            .ok_or_else(|| Error::new(ErrorCode::UnsafePath, "manifest file name is missing"))?,
+    )?;
+    Ok((PrivateDirectory::open_trusted(parent)?, name))
+}
+
