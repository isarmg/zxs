+#[test]
+fn manifest_reader_rejects_public_linked_foreign_and_malformed_evidence() {
+    let (temp, engine, path) = fixture();
+    engine.export_recovery_data_manifest(&path).unwrap();
+    let original = fs::read(&path).unwrap();
+    fs::set_permissions(&path, fs::Permissions::from_mode(0o644)).unwrap();
+    assert!(RecoveryDataManifest::read_trusted(&path, &[]).is_err());
+    fs::set_permissions(&path, fs::Permissions::from_mode(0o600)).unwrap();
+    let alias = temp.path().join("alias.json");
+    fs::hard_link(&path, &alias).unwrap();
+    assert!(RecoveryDataManifest::read_trusted(&path, &[]).is_err());
+    fs::remove_file(&alias).unwrap();
+    std::os::unix::fs::symlink(&path, &alias).unwrap();
+    assert!(RecoveryDataManifest::read_trusted(&alias, &[]).is_err());
+    for change in ["foreign", "duplicate", "unknown", "format"] {
+        let mut value: json_codec::Value = json_codec::from_slice(&original).unwrap();
+        match change {
+            "foreign" => {
+                value["bindings"][0]["identity"]["pool_id"] = crate::new_id("pool").unwrap().into()
+            }
+            "duplicate" => {
+                let binding = value["bindings"][0].clone();
+                value["bindings"].as_array_mut().unwrap().push(binding);
+            }
+            "unknown" => value["candidate_root"] = "/not-authority".into(),
+            "format" => value["format"] = "invented".into(),
+            _ => unreachable!(),
+        }
+        fs::write(&path, json_codec::to_vec(&value).unwrap()).unwrap();
+        assert!(
+            RecoveryDataManifest::read_trusted(&path, &[]).is_err(),
+            "{change}"
+        );
+    }
+    fs::write(
+        &path,
+        br#"{"format":"pre-loss-data-bindings","format":"pre-loss-data-bindings"}"#,
+    )
