 use std::process::Command;
+
+#[test]
+fn explicit_data_recovery_uses_the_cli_export_after_system_loss_and_relocation() {
+    use std::os::unix::fs::PermissionsExt;
+    use storage_engine::{Config, Engine};
+    let temp = tempfile::Builder::new()
+        .permissions(std::fs::Permissions::from_mode(0o700))
+        .tempdir()
+        .unwrap();
+    let old_system = temp.path().join("original-system");
+    let voter = temp.path().join("voter");
+    let data = temp.path().join("data");
+    let mut config = Config::development([voter.clone(), data.clone()]).unwrap();
+    config.disks[1].metadata_member = false;
+    let data_id = config.disks[1].disk_id.clone();
+    drop(Engine::initialize(&old_system, config).unwrap());
+    let manifest = temp.path().join("pre-loss.json");
+    let binary = env!("CARGO_BIN_EXE_zxs-rescue");
+    let exported = Command::new(binary)
+        .arg("--root")
+        .arg(&old_system)
+        .args(["export-recovery-data", "--output"])
+        .arg(&manifest)
+        .output()
+        .unwrap();
+    assert!(exported.status.success(), "{exported:?}");
+    let receipt: json_codec::Value = json_codec::from_slice(&exported.stdout).unwrap();
+    assert_eq!(receipt["exported_data_disk_ids"][0], data_id);
+    let original = std::fs::read(&manifest).unwrap();
+    std::fs::rename(&old_system, temp.path().join("lost-system")).unwrap();
+    let relocated = temp.path().join("relocated-data");
+    std::fs::rename(&data, &relocated).unwrap();
+    let restored_system = temp.path().join("restored-system");
+    let restored = Command::new(binary)
+        .arg("--root")
+        .arg(&restored_system)
+        .args(["restore-system", "--disks"])
+        .arg(&voter)
+        .arg("--data-manifest")
+        .arg(&manifest)
+        .arg("--data-root")
+        .arg(format!("{data_id}={}", relocated.display()))
+        .output()
+        .unwrap();
+    assert!(restored.status.success(), "{restored:?}");
+    let engine = Engine::open(&restored_system).unwrap();
+    let roots = engine.recovery_data_roots().unwrap();
+    assert_eq!(roots.len(), 1);
+    assert_eq!(roots[0].identity.disk_id, data_id);
+    assert_eq!(roots[0].root, relocated);
+    assert_eq!(std::fs::read(&manifest).unwrap(), original);
+}
