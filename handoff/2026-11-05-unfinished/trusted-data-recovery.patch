+    fs::write(&f.manifest, b"malformed unselected file").unwrap();
+    f.service
+        .restore_locked(
+            RestoreRequest {
+                disk_ids: vec!["voter-0".into(), "voter-1".into(), "voter-2".into()],
+                data_recovery: None,
+                accept_stale_credentials: false,
+            },
+            |engine| {
+                assert!(engine.recovery_data_roots().unwrap().is_empty());
+                Ok(())
+            },
+        )
+        .unwrap();
+    assert_eq!(fs::read(&f.manifest).unwrap(), b"malformed unselected file");
+}
