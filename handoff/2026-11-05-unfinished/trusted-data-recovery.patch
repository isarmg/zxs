+//! Explicit, independently trusted recovery bindings; candidate paths are never inspected here.
+use crate::Result;
+use std::{
+    collections::BTreeMap,
+    path::{Path, PathBuf},
+};
+use storage_engine::{RecoveryDataManifest, RecoveryDataRoot};
+
+pub(crate) fn load(
+    manifest: Option<&Path>,
+    mappings: &[String],
+    system: &Path,
+    metadata_roots: &[PathBuf],
+) -> Result<Vec<RecoveryDataRoot>> {
+    let Some(manifest) = manifest else {
+        if !mappings.is_empty() {
+            return Err("explicit data roots require a trusted pre-loss manifest".into());
+        }
+        storage_engine::preflight_recovery_paths(system, metadata_roots)?;
+        return Ok(Vec::new());
+    };
+    if mappings.is_empty() {
+        return Err("a recovery manifest requires explicit data-root selections".into());
+    }
+    let mut selected = BTreeMap::new();
+    for mapping in mappings {
+        let (id, path) = mapping
+            .split_once('=')
+            .ok_or("--data-root must be DISK_ID=/absolute/path")?;
+        storage_engine::validate_id(id, "disk")?;
+        let path = PathBuf::from(path);
+        if !path.is_absolute() || selected.insert(id.to_owned(), path).is_some() {
+            return Err("data-root IDs must be unique and paths absolute".into());
+        }
+    }
+    let storage_roots: Vec<_> = metadata_roots
+        .iter()
+        .cloned()
+        .chain(selected.values().cloned())
+        .collect();
+    storage_engine::preflight_recovery_paths(system, &storage_roots)?;
+    let excluded: Vec<_> = std::iter::once(system.to_path_buf())
+        .chain(storage_roots)
+        .collect();
+    Ok(RecoveryDataManifest::read_trusted(manifest, &excluded)?.data_roots(&selected)?)
+}
+
